digraph G { rankdir=LR;   graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.55];
  node  [fontname="DejaVu Sans", fontsize=10, color="#3b4a63", fontcolor="#1b2230", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#5b6475", fontcolor="#3b4a63", arrowsize=0.7]; nodesep=0.5; ranksep=0.9; node [shape=plaintext, fontsize=9]; edge [dir=both, arrowhead=crow, arrowtail=tee];
RUNS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>RUNS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">command</TD></TR><TR><TD ALIGN="LEFT" PORT="2">llm_mode</TD></TR><TR><TD ALIGN="LEFT" PORT="3">models</TD></TR><TR><TD ALIGN="LEFT" PORT="4">prompt_versions</TD></TR><TR><TD ALIGN="LEFT" PORT="5">llm_calls</TD></TR><TR><TD ALIGN="LEFT" PORT="6">tokens_in / out</TD></TR><TR><TD ALIGN="LEFT" PORT="7">started_at</TD></TR></TABLE>>];
ACCOUNTS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>ACCOUNTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">name</TD></TR><TR><TD ALIGN="LEFT" PORT="2">domain UK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">industry</TD></TR><TR><TD ALIGN="LEFT" PORT="4">employees</TD></TR><TR><TD ALIGN="LEFT" PORT="5">source</TD></TR><TR><TD ALIGN="LEFT" PORT="6">evidence / icp / why_now pts</TD></TR><TR><TD ALIGN="LEFT" PORT="7">account_score</TD></TR><TR><TD ALIGN="LEFT" PORT="8">status</TD></TR><TR><TD ALIGN="LEFT" PORT="9">reason</TD></TR><TR><TD ALIGN="LEFT" PORT="10">people_query (json)</TD></TR></TABLE>>];
SIGNALS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>SIGNALS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">account_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">person_id FK (nullable)</TD></TR><TR><TD ALIGN="LEFT" PORT="3">type</TD></TR><TR><TD ALIGN="LEFT" PORT="4">source_url</TD></TR><TR><TD ALIGN="LEFT" PORT="5">published_at</TD></TR><TR><TD ALIGN="LEFT" PORT="6">raw_text</TD></TR><TR><TD ALIGN="LEFT" PORT="7">uses_competitor / uses_cassandra</TD></TR><TR><TD ALIGN="LEFT" PORT="8">product, use_case, why_now</TD></TR><TR><TD ALIGN="LEFT" PORT="9">confidence</TD></TR><TR><TD ALIGN="LEFT" PORT="10">evidence_quote</TD></TR><TR><TD ALIGN="LEFT" PORT="11">value</TD></TR></TABLE>>];
LEADS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>LEADS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">account_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">first / last name</TD></TR><TR><TD ALIGN="LEFT" PORT="3">title</TD></TR><TR><TD ALIGN="LEFT" PORT="4">persona</TD></TR><TR><TD ALIGN="LEFT" PORT="5">skills (json)</TD></TR><TR><TD ALIGN="LEFT" PORT="6">linkedin_url</TD></TR><TR><TD ALIGN="LEFT" PORT="7">email</TD></TR><TR><TD ALIGN="LEFT" PORT="8">rank</TD></TR><TR><TD ALIGN="LEFT" PORT="9">status</TD></TR><TR><TD ALIGN="LEFT" PORT="10">reason</TD></TR></TABLE>>];
MESSAGES [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>MESSAGES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">lead_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">run_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">channel</TD></TR><TR><TD ALIGN="LEFT" PORT="4">variant</TD></TR><TR><TD ALIGN="LEFT" PORT="5">subject, body</TD></TR><TR><TD ALIGN="LEFT" PORT="6">original_body</TD></TR><TR><TD ALIGN="LEFT" PORT="7">evidence_ids (json)</TD></TR><TR><TD ALIGN="LEFT" PORT="8">value_prop_ids (json)</TD></TR><TR><TD ALIGN="LEFT" PORT="9">approval_route</TD></TR><TR><TD ALIGN="LEFT" PORT="10">status</TD></TR><TR><TD ALIGN="LEFT" PORT="11">reviewer_note</TD></TR><TR><TD ALIGN="LEFT" PORT="12">prompt_version, model, tokens</TD></TR><TR><TD ALIGN="LEFT" PORT="13">created_at, sent_at</TD></TR></TABLE>>];
EVENTS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#3b4a63"><TR><TD BGCOLOR="#2f5bd3"><FONT COLOR="white"><B>EVENTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">lead_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">run_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">type</TD></TR><TR><TD ALIGN="LEFT" PORT="4">payload (json)</TD></TR><TR><TD ALIGN="LEFT" PORT="5">occurred_at</TD></TR></TABLE>>];
ACCOUNTS -> SIGNALS [label="has evidence"];
ACCOUNTS -> LEADS [label="employs"];
LEADS -> SIGNALS [label="named in", arrowtail=teeodot];
LEADS -> MESSAGES [label="receives"];
LEADS -> EVENTS [label="lifecycle"];
RUNS -> MESSAGES [label="produced"];
RUNS -> EVENTS [label="logged"];
}