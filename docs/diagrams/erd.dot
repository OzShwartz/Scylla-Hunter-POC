digraph G { rankdir=LR; graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.55];
  node  [fontname="DejaVu Sans", fontsize=10, color="#3b4a63", fontcolor="#1b2230", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#5b6475", fontcolor="#3b4a63", arrowsize=0.7]; nodesep=0.5; ranksep=0.9; node [shape=plaintext, fontsize=9]; edge [dir=both, arrowhead=crow, arrowtail=tee];
