digraph G { rankdir=LR;   graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.55];
  node  [fontname="DejaVu Sans", fontsize=10, color="#3b4a63", fontcolor="#1b2230", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#5b6475", fontcolor="#3b4a63", arrowsize=0.7];
  node [shape=box, style="rounded,filled", fillcolor="#eef2f8"];
  subgraph cluster_s { label="Signal sources"; style="rounded,dashed"; color="#5b6475";
    S1 [label="Job boards,\ncareers pages"]; S2 [label="Customer pages,\ntalks, blogs"]; S3 [label="Technographics,\npeople-data API"]; S4 [label="GitHub, product\nand intent signals"]; }
  subgraph cluster_o { label="n8n: WHEN"; style="rounded,dashed"; color="#5b6475";
    N1 [label="Schedule:\ndiscovery"]; N2 [label="Webhook:\naccepted / replied"]; N3 [label="Schedule:\ndue follow-ups"]; }
  HS [label="Hunter service (Python)\nsame core: WHAT", fillcolor="#2f5bd3", fontcolor="white"];
  LLM [label="Claude API\nHOW it is worded"]; PG [shape=cylinder, fillcolor="#e8f4ec", label="Postgres\nevidence + audit"];
  SF [shape=cylinder, fillcolor="#e8f4ec", label="Salesforce\nsystem of record"]; REV [label="SDR approval queue", fillcolor="#fff6e0"];
  LI [label="LinkedIn\nsent manually by SDR"]; EM [label="Email sequences\n(tool TBD)"];
  S1 -> N1; S2 -> N1; S3 -> N1; S4 -> N1; N1 -> HS; N2 -> HS; N3 -> HS;
  HS -> LLM [dir=both]; HS -> PG [dir=both]; HS -> SF [label="accounts, leads, tasks"]; SF -> REV; REV -> LI; REV -> EM;
  LI -> N2 [style=dashed, label="acceptance"]; EM -> N2 [style=dashed, label="reply"];
}
